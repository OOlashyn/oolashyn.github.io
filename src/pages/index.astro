---
import HomeLayout from '@/layouts/HomeLayout.astro';
import PostCard from '@/components/PostCard.astro';
import HeroPost from '@/components/HeroPost.astro';
import { siteConfig } from '@/config';
import { getSortedPosts } from '@/utils';

// Page 1 of the post list: the newest post as a hero, then the first page of the grid.
// The remaining pages are generated by page[page].astro.
const [heroPost, ...rest] = await getSortedPosts();
const posts = rest.slice(0, siteConfig.postsPerPage);
const nextUrl = rest.length > siteConfig.postsPerPage ? '/page2/' : undefined;
---

<HomeLayout
  description={siteConfig.description}
  nextUrl={nextUrl}
>
  <HeroPost post={heroPost} />
  <ol class="post-card-grid">
    {posts.map((post) => <PostCard post={post} gridCard={true} />)}
  </ol>
</HomeLayout>
