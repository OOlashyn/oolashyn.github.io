---
import MissingLayout from '@/layouts/MissingLayout.astro';

// Star field rendered at build time (stars created from a script wouldn't get this page's scoped
// styles). Each star drifts right-to-left on the compositor (translate/opacity only), starting
// part-way through its loop so the sky is full from the first frame.
const random = (min: number, max: number): number => min + Math.random() * (max - min);
const stars = Array.from({ length: 80 }, () => {
  const duration = random(4, 8);
  return {
    top: random(0, 100).toFixed(1),
    left: random(0, 100).toFixed(1),
    duration: duration.toFixed(2),
    delay: (-random(0, duration)).toFixed(2),
    twinkleDelay: (-random(0, 3)).toFixed(2),
  };
});
---

<MissingLayout title="Page Not Found" description="Page not found">
  <style>
    .message-content {
      width: 100vw;
      position: relative;
      margin: 0;
      padding: 0;
      font-family: 'Tomorrow', sans-serif;
      height: 70vh;
      background-image: linear-gradient(to top, #2e1753, #1f1746, #131537, #0d1028, #050819);
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
    }

    .text {
      position: absolute;
      top: 10%;
      color: #fff;
      text-align: center;
    }

    .error-code {
      font-size: 50px;
      color: #fff;
    }

    .star {
      position: absolute;
      top: var(--top);
      right: 0;
      width: 2px;
      height: 2px;
      background: #fff;
      animation:
        starFly var(--duration) linear var(--delay) infinite,
        starTwinkle 3s linear var(--twinkle-delay) infinite;
    }

    .astronaut img {
      width: 100px;
      position: absolute;
      top: 55%;
      left: 0;
      animation: astronautFly 6s infinite linear;
    }

    @keyframes starFly {
      from { translate: 0 0; }
      to { translate: calc(-100vw - 4px) 0; }
    }

    @keyframes starTwinkle {
      0%, 100% { opacity: 0.4; }
      25%, 75% { opacity: 0.8; }
      50% { opacity: 1; }
    }

    /* Same path as before (top 50–60% of the 70vh box), as transforms instead of left/top */
    @keyframes astronautFly {
      0% { translate: -100px 0; rotate: 0deg; }
      25% { translate: 25vw -3.5vh; rotate: 30deg; }
      50% { translate: 50vw 0; rotate: 45deg; }
      75% { translate: 75vw 3.5vh; rotate: 30deg; }
      100% { translate: 110vw 0; rotate: 45deg; }
    }

    /* Reduced motion: a still sky, stars spread out, astronaut parked */
    @media (prefers-reduced-motion: reduce) {
      .star {
        right: auto;
        left: var(--left);
        animation: none;
        opacity: 0.8;
      }

      .astronaut img {
        animation: none;
        translate: 60vw 0;
        rotate: 30deg;
      }
    }
  </style>

  <div class="message-content">
    {stars.map((star) => (
      <div
        class="star"
        aria-hidden="true"
        style={`--top: ${star.top}%; --left: ${star.left}%; --duration: ${star.duration}s; --delay: ${star.delay}s; --twinkle-delay: ${star.twinkleDelay}s`}
      />
    ))}
    <div class="text">
      <div>ERROR</div>
      <h1 class="error-code">404</h1>
      <hr />
      <div>Page Not Found</div>
    </div>
    <div class="astronaut">
      <img
        src="https://images.vexels.com/media/users/3/152639/isolated/preview/506b575739e90613428cdb399175e2c8-space-astronaut-cartoon-by-vexels.png"
        alt=""
        class="src"
      />
    </div>
  </div>

</MissingLayout>
