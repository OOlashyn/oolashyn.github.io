---
import HomeLayout from '@/layouts/HomeLayout.astro';
import { getImage, Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@/config';
import { projectCategories, projects } from '@/data/projects';
import type { Project } from '@/data/projects';

// Three 300px+ columns fit the 960px wrapper, two below that, one on phones (see _projects.scss)
const mediaSizes = '(min-width: 1045px) 307px, (min-width: 700px) 44vw, 90vw';

const sections = await Promise.all(
  projectCategories.map(async (category) => ({
    category,
    id: category.toLowerCase().replace(/\s+/g, '-'),
    projects: await Promise.all(
      projects
        .filter((project) => project.category === category)
        .map(async (project: Project) => ({
          ...project,
          isExternal: !project.url.startsWith('/'),
          // What the viewer dialog shows: the clip itself, or the screenshot at full size
          viewerSrc:
            project.media.kind === 'video'
              ? `/assets/videos/${project.media.src}`
              : (await getImage({
                  src: project.media.src,
                  width: Math.min(1920, project.media.src.width),
                  format: 'webp',
                })).src,
        })),
    ),
  })),
);

// Only the first card can be above the fold
const firstProject = sections[0]?.projects[0];

const pictureWidths = (width: number): number[] => [400, 800, 1280].filter((w) => w <= width);
---

<HomeLayout
  title="Projects"
  description="Open-source Power Pages tools and Power Apps (PCF) components I've built and maintain."
>
  <div class="projects-page">
    <header class="projects-intro">
      <h1>Projects</h1>
      <p>Open-source tools and components I've built for Power Pages and Power Apps.</p>
      {siteConfig.github && (
        <a class="projects-github" href={`https://github.com/${siteConfig.github}`}>
          <Icon name="simple-icons:github" aria-hidden="true" />
          More on GitHub
        </a>
      )}
    </header>

    {sections.map((section) => (
      <section class="projects-section" aria-labelledby={section.id}>
        <h2 id={section.id}>{section.category}</h2>
        <ul class="projects-grid">
          {section.projects.map((project) => {
            const isFirst = project === firstProject;
            return (
              <li class="project-card">
                <div class="project-card__media">
                  {/* A still: at card size a clip is too small to follow, so it plays in the viewer */}
                  <Picture
                    src={project.media.kind === 'video' ? project.media.poster : project.media.src}
                    alt={project.media.alt}
                    formats={['avif', 'webp']}
                    widths={pictureWidths(
                      (project.media.kind === 'video' ? project.media.poster : project.media.src).width,
                    )}
                    sizes={mediaSizes}
                    loading={isFirst ? 'eager' : 'lazy'}
                  />
                  {/* The viewer needs the page script, so the button shows only once it runs */}
                  <button
                    type="button"
                    class="project-card__open"
                    aria-label={project.media.kind === 'video'
                      ? `Play the ${project.title} demo`
                      : `Enlarge the ${project.title} screenshot`}
                    data-kind={project.media.kind}
                    data-src={project.viewerSrc}
                    data-width={(project.media.kind === 'video' ? project.media.poster : project.media.src).width}
                    data-height={(project.media.kind === 'video' ? project.media.poster : project.media.src).height}
                    data-alt={project.media.alt}
                    data-title={project.title}
                    hidden
                  >
                    <Icon name={project.media.kind === 'video' ? 'lucide:play' : 'lucide:maximize-2'} aria-hidden="true" />
                  </button>
                </div>
                <div class="project-card__body">
                  <h3>
                    <a href={project.url}>
                      {project.title}
                      <Icon name={project.isExternal ? 'lucide:arrow-up-right' : 'lucide:arrow-right'} aria-hidden="true" />
                    </a>
                  </h3>
                  <p>{project.description}</p>
                  <ul class="project-card__tags" aria-label="Built with">
                    {project.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>

  <!-- One viewer for every card: a native modal dialog, so it traps focus, closes on Escape and
       light dismiss (closedby, with a fallback in the script) and returns focus to the button -->
  <dialog class="project-viewer" id="project-viewer" closedby="any" aria-labelledby="project-viewer-title">
    <figure class="project-viewer__figure">
      <figcaption class="project-viewer__header">
        <h2 id="project-viewer-title" class="project-viewer__title"></h2>
        <button type="button" class="project-viewer__close" aria-label="Close">
          <Icon name="lucide:x" aria-hidden="true" />
        </button>
      </figcaption>
      <div class="project-viewer__media"></div>
    </figure>
  </dialog>
</HomeLayout>

<script>
  // Viewer: the cards are too small to make out the details, so any card's media opens large
  const viewer = document.querySelector<HTMLDialogElement>('#project-viewer');
  const viewerTitle = viewer?.querySelector<HTMLElement>('.project-viewer__title');
  const viewerMedia = viewer?.querySelector<HTMLElement>('.project-viewer__media');

  const openViewer = (button: HTMLButtonElement): void => {
    if (!viewer || !viewerTitle || !viewerMedia) return;
    const { kind, src, width, height, alt, title } = button.dataset;
    if (!src) return;

    // Size the media box before anything loads, or the dialog opens as a bare header and then
    // jumps to full height once the clip's metadata or the image arrives
    viewerMedia.style.setProperty('--ratio', String(Number(width) / Number(height) || 16 / 9));
    // The card's still is already loaded, so it shows at once while the full media loads
    const still = button.parentElement?.querySelector('img')?.currentSrc ?? '';

    viewerTitle.textContent = title ?? '';
    if (kind === 'video') {
      const video = document.createElement('video');
      // The reader asked for this clip, so it plays straight away (reduced motion included)
      Object.assign(video, { src, poster: still, muted: true, loop: true, playsInline: true, controls: true, autoplay: true });
      video.setAttribute('aria-label', alt ?? '');
      viewerMedia.replaceChildren(video);
    } else {
      const img = document.createElement('img');
      Object.assign(img, { src, alt: alt ?? '' });
      if (still) img.style.backgroundImage = `url("${still}")`;
      viewerMedia.replaceChildren(img);
    }

    viewer.showModal();
  };

  for (const button of document.querySelectorAll<HTMLButtonElement>('.project-card__open')) {
    button.hidden = false;
    button.addEventListener('click', () => openViewer(button));
    // A click on the still opens it too; keyboard users have the button
    button.parentElement?.classList.add('is-expandable');
    button.parentElement?.querySelector('img')?.addEventListener('click', () => openViewer(button));
  }

  viewer?.querySelector('.project-viewer__close')?.addEventListener('click', () => viewer.close());

  // Drop the clip so it stops playing and downloading
  viewer?.addEventListener('close', () => viewerMedia?.replaceChildren());

  // Light dismiss where closedby isn't supported (Safari): a click on the backdrop targets the
  // dialog itself, outside its box
  if (viewer && !('closedBy' in HTMLDialogElement.prototype)) {
    viewer.addEventListener('click', (e) => {
      if (e.target !== viewer) return;
      const rect = viewer.getBoundingClientRect();
      const inside = rect.top <= e.clientY && e.clientY <= rect.bottom
        && rect.left <= e.clientX && e.clientX <= rect.right;
      if (!inside) viewer.close();
    });
  }

  // A page restored from the back/forward cache starts with the viewer closed
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) viewer?.close();
  });
</script>
