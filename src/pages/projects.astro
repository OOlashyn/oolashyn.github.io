---
import HomeLayout from '@/layouts/HomeLayout.astro';
import { getImage, Picture } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import { siteConfig } from '@/config';
import { projectCategories, projects } from '@/data/projects';
import type { Project } from '@/data/projects';

// Three 300px+ columns fit the 960px wrapper, two below that, one on phones (see _projects.scss)
const mediaSizes = '(min-width: 1045px) 307px, (min-width: 700px) 44vw, 90vw';

const sections = await Promise.all(
  projectCategories.map(async (category) => ({
    category,
    id: category.toLowerCase().replace(/\s+/g, '-'),
    projects: await Promise.all(
      projects
        .filter((project) => project.category === category)
        .map(async (project: Project) => ({
          ...project,
          isExternal: !project.url.startsWith('/'),
          posterUrl:
            project.media.kind === 'video'
              ? (await getImage({
                  src: project.media.poster,
                  width: Math.min(1280, project.media.poster.width),
                  format: 'webp',
                })).src
              : undefined,
        })),
    ),
  })),
);

// Only the first card can be above the fold
const firstProject = sections[0]?.projects[0];

const pictureWidths = (width: number): number[] => [400, 800, 1280].filter((w) => w <= width);

// Lazy-loading media (Chrome 150+) defers the poster; Astro's types don't list it on <video> yet
const lazyVideo = { loading: 'lazy' };
---

<HomeLayout
  title="Projects"
  description="Open-source Power Pages tools and Power Apps (PCF) components I've built and maintain."
>
  <div class="projects-page">
    <header class="projects-intro">
      <h1>Projects</h1>
      <p>Open-source tools and components I've built for Power Pages and Power Apps.</p>
      {siteConfig.github && (
        <a class="projects-github" href={`https://github.com/${siteConfig.github}`}>
          <Icon name="simple-icons:github" aria-hidden="true" />
          More on GitHub
        </a>
      )}
    </header>

    {sections.map((section) => (
      <section class="projects-section" aria-labelledby={section.id}>
        <h2 id={section.id}>{section.category}</h2>
        <ul class="projects-grid">
          {section.projects.map((project) => {
            const isFirst = project === firstProject;
            return (
              <li class="project-card">
                <div class="project-card__media">
                  {project.media.kind === 'video' ? (
                    <Fragment>
                      <video
                        muted
                        loop
                        playsinline
                        controls
                        preload="none"
                        {...(isFirst ? {} : lazyVideo)}
                        poster={project.posterUrl}
                        width={project.media.poster.width}
                        height={project.media.poster.height}
                        aria-label={project.media.alt}
                      >
                        <source src={`/assets/videos/${project.media.src}`} type="video/mp4" />
                      </video>
                      <button type="button" class="project-card__toggle" aria-label="Play demo" hidden>
                        <Icon name="lucide:play" class="project-card__play-icon" aria-hidden="true" />
                        <Icon name="lucide:pause" class="project-card__pause-icon" aria-hidden="true" />
                      </button>
                    </Fragment>
                  ) : (
                    <Picture
                      src={project.media.src}
                      alt={project.media.alt}
                      formats={['avif', 'webp']}
                      widths={pictureWidths(project.media.src.width)}
                      sizes={mediaSizes}
                      loading={isFirst ? 'eager' : 'lazy'}
                    />
                  )}
                </div>
                <div class="project-card__body">
                  <h3>
                    <a href={project.url}>
                      {project.title}
                      {project.isExternal && <Icon name="lucide:arrow-up-right" aria-hidden="true" />}
                    </a>
                  </h3>
                  <p>{project.description}</p>
                  <ul class="project-card__tags" aria-label="Built with">
                    {project.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
  </div>
</HomeLayout>

<script>
  // Demo clips play only while on screen, and never for readers who prefer reduced motion.
  // There's no autoplay attribute, so with preload="none" nothing downloads until a clip plays.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const videos = document.querySelectorAll<HTMLVideoElement>('.project-card__media video');
  const visible = new Set<HTMLVideoElement>();
  // Pauses made here, so they can be told apart from the reader pausing a clip
  const autoPaused = new WeakSet<HTMLVideoElement>();
  const pausedByReader = new WeakSet<HTMLVideoElement>();

  const play = (video: HTMLVideoElement): void => {
    if (reducedMotion.matches || pausedByReader.has(video) || !video.paused) return;
    // The browser may refuse to autoplay (e.g. in data saver mode); the poster and button remain
    video.play().catch(() => {});
  };

  const pause = (video: HTMLVideoElement): void => {
    if (video.paused) return;
    autoPaused.add(video);
    video.pause();
  };

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) {
          visible.add(video);
          play(video);
        } else {
          visible.delete(video);
          pause(video);
        }
      }
    },
    { threshold: 0.5 },
  );

  for (const video of videos) {
    // Swap the native controls (the no-JS fallback) for one play/pause button, which doesn't
    // cover the clip and is the pause control autoplaying motion needs
    const toggle = video.parentElement?.querySelector<HTMLButtonElement>('.project-card__toggle');
    if (toggle) {
      video.controls = false;
      toggle.hidden = false;
      toggle.addEventListener('click', () => {
        if (video.paused) {
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    }

    const syncToggle = (): void => {
      toggle?.setAttribute('aria-label', video.paused ? 'Play demo' : 'Pause demo');
      toggle?.classList.toggle('is-playing', !video.paused);
    };

    video.addEventListener('pause', () => {
      if (autoPaused.has(video)) {
        autoPaused.delete(video);
      } else {
        pausedByReader.add(video);
      }
      syncToggle();
    });
    video.addEventListener('play', () => {
      pausedByReader.delete(video);
      syncToggle();
    });
    observer.observe(video);
  }

  reducedMotion.addEventListener('change', () => {
    for (const video of visible) {
      if (reducedMotion.matches) {
        pause(video);
      } else {
        play(video);
      }
    }
  });
</script>
