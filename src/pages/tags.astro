---
import HomeLayout from '@/layouts/HomeLayout.astro';
import { formatPostDate, getPostUrl, getSortedPosts } from '@/utils';

// Posts are already newest first, so each tag's list keeps that order
const allPosts = await getSortedPosts();

// Build tag map: tag -> posts
const tagMap = new Map<string, typeof allPosts>();
for (const post of allPosts) {
  for (const tag of post.data.tags || []) {
    if (!tagMap.has(tag)) {
      tagMap.set(tag, []);
    }
    tagMap.get(tag)!.push(post);
  }
}

// Sort tags alphabetically
const sortedTags = [...tagMap.keys()].sort();
---

<HomeLayout title="Tags">
  <section class="blog-tags">
    <h1>Tags in Blog</h1>
    <ul class="tags">
      {sortedTags.map((tag) => (
        <li>
          <a href={`#${encodeURIComponent(tag)}`} class="tag">
            {tag} <span>({tagMap.get(tag)!.length})</span>
          </a>
        </li>
      ))}
    </ul>
    {sortedTags.map((tag) => (
      <>
        <h2 id={encodeURIComponent(tag)}>{tag}</h2>
        {tagMap.get(tag)!.map((post) => (
          <div class="tag-list">
            <span>
              <a href={getPostUrl(post.id)}>{post.data.title}</a>
            </span>
            <small>
              <span>
                | {formatPostDate(post.data.date)}
              </span>
            </small>
          </div>
        ))}
      </>
    ))}
  </section>
</HomeLayout>
