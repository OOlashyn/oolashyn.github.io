---
import Head, { type ArticleMeta } from '@/components/Head.astro';
import Header from '@/components/Header.astro';
import HeaderInteractions from '@/components/HeaderInteractions.astro';
import NavDrawer from '@/components/NavDrawer.astro';
import '@/styles/main.scss';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: ArticleMeta;
}

const { title, description, image, article } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <Head title={title} description={description} image={image} article={article} />
  <body>
    <div class="page-wrapper">
      <Header />
      <slot />
    </div>
    <NavDrawer />
    <HeaderInteractions />
    <script is:inline>
      document.addEventListener('astro:before-swap', (event) => {
        // Preserve dynamically injected Pagefind CSS link
        document.head.querySelectorAll('link[href="/pagefind/pagefind-ui.css"]').forEach((link) => {
          event.newDocument.head.appendChild(link.cloneNode(true));
        });
      });
    </script>
  </body>
</html>
