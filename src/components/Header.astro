---
import SubscribeModal from '@/components/SubscribeModal.astro';
import { Icon } from 'astro-icon/components';
---

<header class="main-header">
  <div class="wrapper">
    <div class="header-flex">
      <div class="menu-icon-container">
        <button class="menu-icon" aria-label="Open menu" aria-expanded="false" aria-controls="nav-drawer">
          <Icon name="lucide:menu" aria-hidden="true" />
        </button>
      </div>
      <p class="logo" style="margin:0;">
        <a href="/" aria-label="Website Logo">
          <img class="img-logo" src="/assets/img/logo_big.svg" alt="" />
        </a>
      </p>
      <nav class="main-nav" aria-label="Main">
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/projects/">Projects</a></li>
          <li class="nav-subscribe-item">
            <button class="nav-subscribe-btn" id="subscribe-trigger" aria-expanded="false" aria-controls="subscribe-modal">
              Subscribe
            </button>
          </li>
        </ul>
      </nav>
      <div class="search-icon-container">
        <button class="search-icon" aria-label="Open search" aria-expanded="false" aria-controls="search-dialog">
          <Icon name="lucide:search" aria-hidden="true" />
        </button>
        <button class="theme-toggle" type="button" aria-label="Toggle dark theme" aria-pressed="false">
          <Icon name="lucide:sun" class="theme-toggle__sun" aria-hidden="true" />
          <Icon name="lucide:moon" class="theme-toggle__moon" aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>
</header>
<SubscribeModal />

<script>
  // The initial theme is set by the inline script in Head.astro before first paint.
  // Same storage key as the old dark-mode-toggle component, so saved choices carry over.
  // Follows the dark-mode-toggle guide: no stored value = follow the OS; the toggle only stores
  // an override that differs from the OS, and clears it when switching back to the OS theme.
  const STORAGE_KEY = 'dark-mode-toggle';
  type Theme = 'light' | 'dark';

  const systemQuery = window.matchMedia('(prefers-color-scheme: dark)');
  const systemTheme = (): Theme => (systemQuery.matches ? 'dark' : 'light');
  const isTheme = (value: string | null | undefined): value is Theme => value === 'light' || value === 'dark';

  // The rendered theme: the reader's override if any, else the OS preference
  function currentTheme(): Theme {
    const override = document.documentElement.dataset.theme;
    return isTheme(override) ? override : systemTheme();
  }

  function syncToggle(): void {
    document.querySelector('.theme-toggle')?.setAttribute('aria-pressed', String(currentTheme() === 'dark'));
  }

  function notifyThemeChange(): void {
    syncToggle();
    document.dispatchEvent(new CustomEvent('themechange', { detail: { theme: currentTheme() } }));
  }

  // null = follow the OS. CSS reads data-theme; color-scheme follows it for native UI.
  function applyOverride(theme: Theme | null): void {
    const root = document.documentElement;
    if (theme) root.dataset.theme = theme;
    else delete root.dataset.theme;
    document.querySelector('meta[name="color-scheme"]')?.setAttribute('content', theme ?? 'light dark');
    notifyThemeChange();
  }

  // Delegated listener survives ClientRouter navigations (bundled scripts run only once)
  document.addEventListener('click', (e) => {
    if (!(e.target as Element | null)?.closest('.theme-toggle')) return;
    const target: Theme = currentTheme() === 'dark' ? 'light' : 'dark';
    // Switching back to the OS theme undoes the override instead of pinning it, so the site
    // keeps following automatic day/night switching
    const override = target === systemTheme() ? null : target;
    try {
      if (override) localStorage.setItem(STORAGE_KEY, override);
      else localStorage.removeItem(STORAGE_KEY);
    } catch {
      // Storage unavailable (e.g. private mode): the choice lasts for this page only
    }
    applyOverride(override);
  });

  // CSS already follows OS changes when there's no override; keep the toggle and listeners
  // (e.g. Utterances) in step. An existing override is kept even if the OS now matches it.
  systemQuery.addEventListener('change', () => {
    if (!isTheme(document.documentElement.dataset.theme)) notifyThemeChange();
  });

  // Another tab changed the theme
  window.addEventListener('storage', (e) => {
    if (e.key !== STORAGE_KEY && e.key !== null) return;
    applyOverride(isTheme(e.newValue) ? e.newValue : null);
  });

  document.addEventListener('astro:page-load', syncToggle);
</script>
