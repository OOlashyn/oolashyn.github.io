---
import { siteConfig } from '@/config';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@/components/Analytics.astro';

export interface ArticleMeta {
  publishedTime: Date;
  tags: string[];
}

interface Props {
  title?: string;
  description?: string;
  /** Site-relative path, e.g. /assets/img/x.jpg */
  image?: string;
  /** Set on blog posts: adds article Open Graph tags and BlogPosting structured data */
  article?: ArticleMeta;
}

const { title, description, image, article } = Astro.props;
const pageTitle = title ? `${title} - ${siteConfig.title}` : siteConfig.title;
const pageDescription = description || siteConfig.description;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url);
// Social networks and search engines need absolute image URLs
const imageUrl = image ? new URL(image, siteConfig.url).href : undefined;
const feedUrl = new URL('/feed.xml', siteConfig.url).href;

// Structured data for search engines (https://schema.org/BlogPosting)
const jsonLd = article && {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: pageDescription,
  url: canonicalUrl.href,
  mainEntityOfPage: canonicalUrl.href,
  datePublished: article.publishedTime.toISOString(),
  ...(imageUrl && { image: imageUrl }),
  ...(article.tags.length > 0 && { keywords: article.tags.join(', ') }),
  author: {
    '@type': 'Person',
    name: siteConfig.author,
    url: new URL('/about/', siteConfig.url).href,
  },
};
// Escape "<" so content can never close the <script> tag early
const jsonLdHtml = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<head>
  <meta charset="utf-8" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Theme: runs before first paint to avoid a flash of the wrong theme -->
  <script is:inline>
    (function () {
      var root = document.documentElement;
      var stored = null;
      try { stored = localStorage.getItem('dark-mode-toggle'); } catch (e) {}
      root.dataset.theme = stored === 'dark' || stored === 'light'
        ? stored
        : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      // ClientRouter replaces <html> attributes on navigation: carry the theme over
      document.addEventListener('astro:before-swap', function (e) {
        e.newDocument.documentElement.dataset.theme = root.dataset.theme;
      });
    })();
  </script>
  <link rel="manifest" href="/manifest.json" />
  <link rel="canonical" href={canonicalUrl.href} />

  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDescription} />
  <meta property="og:url" content={canonicalUrl.href} />
  <meta property="og:site_name" content={siteConfig.title} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  {imageUrl && <meta property="og:image" content={imageUrl} />}
  {article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
  {article && <meta property="article:author" content={siteConfig.author} />}
  {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content={siteConfig.twitter} />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDescription} />
  {imageUrl && <meta name="twitter:image" content={imageUrl} />}

  <!-- RSS feed discovery for browsers and feed readers -->
  <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href={feedUrl} />

  {jsonLdHtml && <script is:inline type="application/ld+json" set:html={jsonLdHtml} />}

  <!-- Favicon -->
  <link rel="shortcut icon" href="/assets/img/favicon/favicon.ico" type="image/x-icon" />
  <link rel="apple-touch-icon" href="/assets/img/favicon/apple-touch-icon.png" />
  <link rel="apple-touch-icon" sizes="72x72" href="/assets/img/favicon/apple-touch-icon-72x72.png" />
  <link rel="apple-touch-icon" sizes="114x114" href="/assets/img/favicon/apple-touch-icon-114x114.png" />

  <!-- Theme colors -->
  <meta name="theme-color" content="#311e3e" />
  <meta name="msapplication-navbutton-color" content="#311e3e" />
  <meta name="apple-mobile-web-app-status-bar-style" content="#311e3e" />

  <!-- Fonts -->
  <Font cssVariable="--font-montserrat" preload />
  <Font cssVariable="--font-lato" preload />

  <!-- Google verification -->
  <meta name="google-site-verification" content="e33KPrSW7_LHxFoA9XP_rkj1noTjubwKyfeCRAV9seg" />

  <Analytics />

  <ClientRouter />
</head>
