---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  class?: string;
  /**
   * Rendered width hint for the browser to pick the right srcset candidate.
   * With object-fit: cover in a box taller than the image's ratio, use the width
   * the image is scaled to (not the box width), or it will look soft.
   */
  sizes: string;
  /** Set for the largest above-the-fold image (LCP): loads eagerly with high priority */
  priority?: boolean;
}

// Covers are decorative next to the post title, so alt is empty.
// The wrapper <picture> uses display: contents so existing img styles
// (height: 100%, object-fit: cover) keep working against the parent.
const { src, class: className, sizes, priority = false } = Astro.props;
---

<Picture
  src={src}
  alt=""
  class={className}
  formats={['avif', 'webp']}
  widths={[400, 800, 1280].filter((w) => w <= src.width)}
  sizes={sizes}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : 'auto'}
  pictureAttributes={{ class: 'cover-picture' }}
/>
