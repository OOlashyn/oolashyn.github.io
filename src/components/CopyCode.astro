<script>
  // Delegated listener on document: bundled scripts run only once with ClientRouter,
  // but document survives page swaps, so this keeps working after navigation.
  document.addEventListener('click', async (e) => {
    const btn = (e.target as Element | null)?.closest<HTMLButtonElement>('.copy-code-button');
    if (!btn) return;

    const pre = btn.closest('.code-bar')?.nextElementSibling;
    const code = pre?.querySelector('code');
    if (!code) return;

    await navigator.clipboard.writeText(code.textContent ?? '');
    btn.classList.add('copied');
    setTimeout(() => btn.classList.remove('copied'), 2000);
  });
</script>
