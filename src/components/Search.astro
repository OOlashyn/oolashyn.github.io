---
import { Icon } from 'astro-icon/components';
---

<!--
  Full-screen native modal dialog: showModal() (HeaderInteractions.astro) makes the page inert,
  traps focus, closes on Escape / Android back and restores focus to the search button.
-->
<dialog class="search-box" id="search-dialog" aria-label="Search">
  <div class="wrapper">
    <div class="search-grid">
      <div id="search-container">
        <div id="pagefind-search"></div>
      </div>
      <div class="icon-close-container">
        <button class="search-icon-close" type="button" aria-label="Close search">
          <Icon name="lucide:x" aria-hidden="true" />
        </button>
      </div>
    </div>
  </div>
</dialog>

<script>
  type PagefindWindow = Window & { PagefindUI?: new (options: Record<string, unknown>) => unknown };

  // Pagefind's UI is generated by `bun run build` (not available in `astro dev`)
  function initPagefind(): void {
    if (!document.getElementById('pagefind-search')) return;

    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = '/pagefind/pagefind-ui.css';
    link.onerror = () => console.warn('Pagefind CSS not found — run "bun run build" first.');
    document.head.appendChild(link);

    const script = document.createElement('script');
    script.src = '/pagefind/pagefind-ui.js';
    script.onload = () => {
      const { PagefindUI } = window as PagefindWindow;
      if (PagefindUI) new PagefindUI({ element: '#pagefind-search', showSubResults: true, showImages: false });
    };
    script.onerror = () => console.warn('Pagefind JS not found — run "bun run build" first.');
    document.head.appendChild(script);
  }

  initPagefind();
</script>
