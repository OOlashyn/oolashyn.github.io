---
import { getPostUrl, getSortedPosts } from '@/utils';
import CoverImage from '@/components/CoverImage.astro';

const recentPosts = (await getSortedPosts()).slice(0, 4);
---

<div class="recent-box" data-pagefind-ignore>
  <h2 class="recent-title">Recent post</h2>
  <div class="recent-list">
    {recentPosts.map((post) => (
      <a href={getPostUrl(post.id)} class="recent-item">
        <CoverImage
          src={post.data.img}
          class="recent-item__image"
          sizes="(max-width: 480px) 100vw, (max-width: 768px) 50vw, 225px"
        />
        <span class="recent-item__title">{post.data.title}</span>
      </a>
    ))}
  </div>
</div>
