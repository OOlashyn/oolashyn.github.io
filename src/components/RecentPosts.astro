---
import { getCollection } from 'astro:content';
import { getPostUrl } from '@/utils';

const allPosts = await getCollection('posts');
const recentPosts = allPosts
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
---

<div class="recent-box" data-pagefind-ignore>
  <h2 class="recent-title">Recent post</h2>
  <div class="recent-list">
    {recentPosts.map((post) => (
      <a href={getPostUrl(post.id)} class="recent-item">
        <img
          class="recent-item__image"
          src={`/assets/img/${post.data.img}`}
          alt=""
          loading="lazy"
          decoding="async"
        />
        <span class="recent-item__title">{post.data.title}</span>
      </a>
    ))}
  </div>
</div>
