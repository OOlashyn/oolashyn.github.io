---
import { siteConfig } from '@/config';

// Cloudflare Web Analytics (cookieless). Rendered in <head> so ClientRouter keeps the
// identical script across navigations instead of re-running it; the beacon tracks
// client-side route changes itself via the History API.
const { cloudflareToken } = siteConfig.analytics;
---

{cloudflareToken && (
  <script
    is:inline
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token: cloudflareToken })}
  ></script>
)}
