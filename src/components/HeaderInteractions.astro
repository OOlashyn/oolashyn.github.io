<script>
  function initHeaderInteractions() {
    const w = window as unknown as Record<string, unknown>;
    if (w.__headerAbort) (w.__headerAbort as AbortController).abort();
    const controller = new AbortController();
    w.__headerAbort = controller;
    const { signal } = controller;

    const pageWrapper = document.querySelector<HTMLElement>('div.page-wrapper');
    const menuButton = document.querySelector<HTMLElement>('.menu-icon');
    const drawer = document.querySelector<HTMLElement>('#nav-drawer');
    const scroller = drawer?.querySelector<HTMLElement>('.nav-drawer__scroller');
    const sheet = drawer?.querySelector<HTMLElement>('.nav-drawer__sheet');

    const isDrawerOpen = (): boolean => drawer?.matches(':popover-open') ?? false;

    // Navigation drawer. The swipe is native scroll snapping, so opening and closing are just
    // scrolls; the IntersectionObserver below reacts to every way the sheet can move.
    async function openDrawer(): Promise<void> {
      if (!drawer || !scroller) return;
      drawer.showPopover();
      // Without scroll-initial-target the popover opens scrolled to the sheet: jump to the
      // closed stop first so it slides in. Two frames let the jump commit before scrolling back.
      if (!CSS.supports('scroll-initial-target', 'nearest')) {
        scroller.scrollTo({ left: scroller.scrollWidth, behavior: 'instant' });
        await new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
      }
      // 'auto' defers to the CSS scroll-behavior: smooth unless reduced motion is preferred
      scroller.scrollTo({ left: 0, behavior: 'auto' });
    }

    function closeDrawer(): void {
      // The observer hides the popover once the sheet is off-screen, so the slide-out shows
      scroller?.scrollTo({ left: scroller.scrollWidth, behavior: 'auto' });
    }

    function onDrawerOpened(): void {
      if (pageWrapper) pageWrapper.inert = true;
      menuButton?.setAttribute('aria-expanded', 'true');
      sheet?.focus({ preventScroll: true });
    }

    function onDrawerClosed(): void {
      if (!drawer || !isDrawerOpen()) return;
      const hadFocus = drawer.contains(document.activeElement);
      drawer.hidePopover();
      if (pageWrapper) pageWrapper.inert = false;
      menuButton?.setAttribute('aria-expanded', 'false');
      if (hadFocus) menuButton?.focus({ preventScroll: true });
    }

    if (drawer && scroller && sheet) {
      // Any visible pixel of the sheet counts as "not closed"
      const visibleThreshold = 1 / window.innerWidth;
      const observer = new IntersectionObserver((entries) => {
        // Only the latest entry describes the current position
        const entry = entries.at(-1);
        if (!entry) return;
        if (entry.intersectionRatio < visibleThreshold) onDrawerClosed();
        if (entry.intersectionRatio === 1) onDrawerOpened();
      }, { root: drawer, threshold: [visibleThreshold, 1] });
      observer.observe(sheet);
      signal.addEventListener('abort', () => observer.disconnect());

      // Without scroll-driven animations, fade the backdrop from a scroll listener instead
      if (!CSS.supports('animation-timeline: scroll()')) {
        scroller.addEventListener('scroll', () => {
          const ratio = 1 - scroller.scrollLeft / sheet.offsetWidth;
          drawer.style.setProperty('--drawer-backdrop', String(Math.min(Math.max(ratio, 0), 1)));
        }, { passive: true, signal });
      }

      menuButton?.addEventListener('click', (e) => {
        e.preventDefault();
        void openDrawer();
      }, { signal });

      drawer.querySelector<HTMLElement>('.nav-drawer__close')?.addEventListener('click', closeDrawer, { signal });

      // Light dismiss: a tap on the dimmed area, outside the sheet
      drawer.addEventListener('click', (e) => {
        if (!sheet.contains(e.target as Node)) closeDrawer();
      }, { signal });

      // Leaving the mobile layout (where the menu button is hidden) closes the drawer at once
      window.matchMedia('(max-width: 768px)').addEventListener('change', (e) => {
        if (e.matches || !isDrawerOpen()) return;
        scroller.scrollTo({ left: scroller.scrollWidth, behavior: 'instant' });
        onDrawerClosed();
      }, { signal });
    }

    // Search open
    document.querySelectorAll<HTMLElement>('.search-icon').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const searchBox = document.querySelector<HTMLElement>('.search-box');
        if (searchBox) {
          searchBox.classList.add('search-active');
          el.setAttribute('aria-expanded', 'true');
          searchBox.querySelector<HTMLElement>('input')?.focus();
        }
      }, { signal });
    });

    // Search close
    document.querySelectorAll<HTMLElement>('.search-icon-close').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        const searchBox = document.querySelector<HTMLElement>('.search-box');
        if (searchBox) {
          searchBox.classList.remove('search-active');
          document.querySelector<HTMLElement>('.search-icon')?.setAttribute('aria-expanded', 'false');
        }
      }, { signal });
    });

    // Subscribe modal: a native <dialog>. showModal() handles focus, the focus trap, inertness,
    // Escape and focus restore; closedby="any" adds light dismiss where supported.
    const subscribeModal = document.querySelector<HTMLDialogElement>('#subscribe-modal');
    const subscribeTrigger = document.querySelector<HTMLElement>('#subscribe-trigger');

    // Exit animations need transitionable display + overlay (not in Firefox/Safari yet). Firefox
    // parses allow-discrete without honouring it for display, so probe the real behaviour.
    const supportsTopLayerExit = (): boolean => {
      if (!CSS.supports('overlay', 'auto') || !CSS.supports('transition-behavior', 'allow-discrete')) return false;
      const probe = document.createElement('div');
      probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
      document.body.appendChild(probe);
      getComputedStyle(probe).display;
      probe.style.display = 'none';
      const supported = getComputedStyle(probe).display === 'block';
      probe.remove();
      return supported;
    };

    async function closeSubscribeModal(): Promise<void> {
      if (!subscribeModal?.open) return;
      if (!supportsTopLayerExit()) {
        // Play the exit transition while the dialog is still open, then close it
        subscribeModal.setAttribute('data-closing', '');
        const animations = subscribeModal.getAnimations({ subtree: true });
        if (animations.length > 0) {
          await Promise.race([
            Promise.allSettled(animations.map((a) => a.finished)),
            new Promise((resolve) => setTimeout(resolve, 1000)),
          ]);
        }
        if (!subscribeModal.hasAttribute('data-closing')) return;
        subscribeModal.removeAttribute('data-closing');
      }
      subscribeModal.close();
    }

    if (subscribeModal) {
      subscribeTrigger?.addEventListener('click', () => {
        subscribeModal.removeAttribute('data-closing');
        subscribeModal.showModal();
        subscribeTrigger.setAttribute('aria-expanded', 'true');
      }, { signal });

      subscribeModal.querySelector<HTMLElement>('.subscribe-modal__close')
        ?.addEventListener('click', () => void closeSubscribeModal(), { signal });

      // Route Escape and native light dismiss through the same animated close
      subscribeModal.addEventListener('cancel', (e) => {
        e.preventDefault();
        void closeSubscribeModal();
      }, { signal });

      subscribeModal.addEventListener('close', () => {
        subscribeTrigger?.setAttribute('aria-expanded', 'false');
      }, { signal });

      // Light dismiss where closedby isn't supported (Safari): a click on the backdrop targets
      // the dialog itself, outside its box (the box is exactly the card)
      if (!('closedBy' in HTMLDialogElement.prototype)) {
        subscribeModal.addEventListener('click', (e) => {
          if (e.target !== subscribeModal) return;
          const rect = subscribeModal.getBoundingClientRect();
          const inside = rect.top <= e.clientY && e.clientY <= rect.bottom
            && rect.left <= e.clientX && e.clientX <= rect.right;
          if (!inside) void closeSubscribeModal();
        }, { signal });
      }
    }

    // Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        const searchBox = document.querySelector<HTMLElement>('.search-box');
        // The open dialog handles its own Escape (see the cancel listener above)
        if (subscribeModal?.open) return;
        if (isDrawerOpen()) {
          closeDrawer();
        } else if (searchBox?.classList.contains('search-active')) {
          searchBox.classList.remove('search-active');
          document.querySelector<HTMLElement>('.search-icon')?.setAttribute('aria-expanded', 'false');
        }
      }
    }, { signal });
  }

  document.addEventListener('astro:page-load', initHeaderInteractions);
  window.addEventListener('pageshow', (e) => { if (e.persisted) initHeaderInteractions(); });
</script>
