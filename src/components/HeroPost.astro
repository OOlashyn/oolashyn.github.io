---
import type { CollectionEntry } from 'astro:content';
import { formatPostDate, getPostUrl, getTagUrl } from '@/utils';
import { Icon } from 'astro-icon/components';
import CoverImage from '@/components/CoverImage.astro';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const category = post.data.tags?.[0] ?? null;
---

<div class="hero-post">
  <a href={getPostUrl(post.id)} aria-label={post.data.title} class="hero-post__image-link">
    <CoverImage
      src={post.data.img}
      class="hero-post__image"
      sizes="(max-width: 768px) 100vw, 720px"
      priority
    />
  </a>
  <div class="hero-post__content">
    <div class="hero-post__meta">
      {category && (
        <ul class="tag-list hero-post__tags">
          <li class="tag">
            <a href={getTagUrl(category)} class="tag-link">#{category}</a>
          </li>
        </ul>
      )}
      <span class="hero-post__date">
        <Icon name="lucide:clock" aria-hidden="true" />
        <time datetime={post.data.date.toISOString()}>
          {formatPostDate(post.data.date)}
        </time>
      </span>
    </div>
    <h2 class="hero-post__title">
      <a href={getPostUrl(post.id)} class="hero-post__title-link">
        {post.data.title}
      </a>
    </h2>
    <p class="hero-post__description">
      {post.data.shortDescription || post.data.description}
    </p>
    <a href={getPostUrl(post.id)} class="hero-post__cta">
      Read the Full Article
    </a>
  </div>
</div>
